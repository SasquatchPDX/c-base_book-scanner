# Development defaults. Do not use the stub identity adapter in production.
BOOK_SCANNER_ENVIRONMENT=development
BOOK_SCANNER_SECRET_KEY=replace-with-at-least-50-random-characters
BOOK_SCANNER_ALLOWED_HOSTS=["localhost","127.0.0.1"]
BOOK_SCANNER_DATABASE_URL=postgresql://ebook:change-me@localhost:5432/ebook
BOOK_SCANNER_REDIS_URL=redis://localhost:6379/0
BOOK_SCANNER_STORAGE_ROOT=/mnt/ebook-server
BOOK_SCANNER_METRICS_ENABLED=true
BOOK_SCANNER_METRICS_BEARER_TOKEN=replace-with-a-long-random-monitoring-token

# LDAP. Either set a user DN template or configure service-bind search.
BOOK_SCANNER_LDAP_MODE=ldap
BOOK_SCANNER_LDAP_SERVER_URI=ldaps://ldap.example.org:636
BOOK_SCANNER_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org
BOOK_SCANNER_LDAP_USER_SEARCH_BASE=
BOOK_SCANNER_LDAP_USER_SEARCH_FILTER=(uid={username})
BOOK_SCANNER_LDAP_SERVICE_BIND_DN=
BOOK_SCANNER_LDAP_SERVICE_BIND_PASSWORD=
BOOK_SCANNER_LDAP_EMAIL_ATTRIBUTE=mail

# Remote OCR worker contract.
BOOK_SCANNER_OCR_SERVICE_URL=http://ocr-ai-server.example.org:8020
BOOK_SCANNER_OCR_REQUEST_TIMEOUT=30
# Polling is wall-clock based: ~25 min deadline, 2s interval backing off to 15s,
# upload timeout 300s, OCR RQ job timeout 2h. Defaults work for real OCR; the
# knobs below are optional. NOTE: set them as process environment variables
# (not in .env) until they are wired into settings.py; .env rejects unknown keys.
#   BOOK_SCANNER_OCR_POLL_DEADLINE_SECONDS=1500
#   BOOK_SCANNER_OCR_POLL_INTERVAL_START_SECONDS=2
#   BOOK_SCANNER_OCR_POLL_INTERVAL_MAX_SECONDS=15
#   BOOK_SCANNER_OCR_SUBMIT_TIMEOUT=300
#   BOOK_SCANNER_OCR_JOB_TIMEOUT_SECONDS=7200
#   BOOK_SCANNER_CONVERTER_TIMEOUT_SECONDS=1800
# Legacy attempt-based settings (only honoured when changed from 40 / 0.2):
# BOOK_SCANNER_OCR_MAX_ATTEMPTS=40
# BOOK_SCANNER_OCR_POLL_INTERVAL_SECONDS=0.2

# Production TLS settings (enable only behind a correctly configured HTTPS proxy).
BOOK_SCANNER_SECURE_SSL_REDIRECT=false
BOOK_SCANNER_SECURE_PROXY_SSL_HEADER=false
BOOK_SCANNER_SESSION_COOKIE_SECURE=false
BOOK_SCANNER_CSRF_COOKIE_SECURE=false
BOOK_SCANNER_SECURE_HSTS_SECONDS=0
BOOK_SCANNER_SECURE_HSTS_PRELOAD=false
BOOK_SCANNER_CSRF_TRUSTED_ORIGINS=[]

# ScanTailor workspace SSE cadence and connection lifetime.
BOOK_SCANNER_SCANTAILOR_EVENT_STREAM_INTERVAL_SECONDS=1.0
BOOK_SCANNER_SCANTAILOR_EVENT_STREAM_MAX_EVENTS=45
