# Development defaults. Do not use the stub identity adapter in production.
BOOK_SCANNER_ENVIRONMENT=development
BOOK_SCANNER_SECRET_KEY=replace-with-at-least-50-random-characters
BOOK_SCANNER_ALLOWED_HOSTS=["localhost","127.0.0.1"]
BOOK_SCANNER_DATABASE_URL=postgresql://ebook:change-me@localhost:5432/ebook
BOOK_SCANNER_REDIS_URL=redis://localhost:6379/0
# The one attached storage (writable network share, not the VM disk). The archive
# (library-artifacts/: originals, conversions, covers, OCR), scan-artifacts/ and upload
# staging live under it; the VM keeps only PostgreSQL/Redis/caches.
BOOK_SCANNER_STORAGE_ROOT=/mnt/ebook-server
# Refuse to write unless the storage root already exists (guards against an unmounted
# NFS/Samba share silently filling the local disk). Optionally require a marker file
# (create it once on the mounted share, e.g. `touch /mnt/ebook-server/.ebook-server-root`).
BOOK_SCANNER_STORAGE_REQUIRE_EXISTING_ROOT=true
BOOK_SCANNER_STORAGE_SENTINEL_FILE=.ebook-server-root
# Imports refuse to archive (and ingest_sources stops queueing) when that would leave
# less than this many bytes free on the archive volume. Default 2 GiB; 0 disables.
BOOK_SCANNER_STORAGE_MIN_FREE_BYTES=2147483648
# Source ingestion: ignore files modified within this many seconds (half-written copies),
# and stop auto-retrying a failing file after this many failed jobs.
BOOK_SCANNER_SOURCE_MIN_AGE_SECONDS=60
BOOK_SCANNER_INGEST_MAX_AUTO_ATTEMPTS=3
# Per-source defaults (override per SourceLocation in admin); 0 = unlimited.
BOOK_SCANNER_INGEST_BATCH_SIZE=100
BOOK_SCANNER_INGEST_MAX_PER_HOUR=0
# Exclusive worker lease on an import job; 0 = queue job timeout + 5 minutes.
BOOK_SCANNER_INGEST_LEASE_SECONDS=0
# Use a sibling cover.jpg/cover.png (Calibre-style) as the front cover when the
# source folder holds a single book. The sidecar file is never moved or deleted.
BOOK_SCANNER_SIDECAR_COVERS_ENABLED=true
# Group per-chapter files of one book (ch01.pdf, ch02.pdf, ...) found in one source
# folder into a single "multi-part work" review task instead of N separate imports.
BOOK_SCANNER_MULTIPART_DETECTION=true
# User-Agent sent to metadata providers. Empty/unset uses the built-in default, which
# names the project and links its repository; override to add your own contact URL.
BOOK_SCANNER_METADATA_USER_AGENT=
# Optional: Hardcover.app (strong English-language coverage). Free personal API token
# from https://hardcover.app/account/api (a read-only catalog scope such as
# read:catalog is enough). Disabled unless BOTH the provider is listed and a token is set:
# BOOK_SCANNER_METADATA_PROVIDERS=["ebook_server.core.identification.OpenLibraryMetadataProvider","ebook_server.core.hardcover_provider.HardcoverMetadataProvider"]
# BOOK_SCANNER_HARDCOVER_API_TOKEN=
# BOOK_SCANNER_HARDCOVER_TIMEOUT_SECONDS=10
# Optional: Deutsche Nationalbibliothek (public SRU catalogue, no key; strong German
# coverage) and Google Books (needs an API key). Both are off unless listed:
# BOOK_SCANNER_METADATA_PROVIDERS=["ebook_server.core.identification.OpenLibraryMetadataProvider","ebook_server.core.metadata_providers.DnbMetadataProvider","ebook_server.core.metadata_providers.GoogleBooksMetadataProvider"]
# BOOK_SCANNER_GOOGLE_BOOKS_API_KEY=
# Client-side pacing for metadata provider APIs, in requests/second per provider_id
# (<= 0 disables). Shared by all workers via Redis when BOOK_SCANNER_REDIS_URL is set.
# Open Library asks bulk clients to stay at about 1 request/second.
BOOK_SCANNER_METADATA_RATE_LIMITS={"openlibrary":1.0}
BOOK_SCANNER_METADATA_RATE_LIMIT_DEFAULT=1.0
# A lookup gives up (provider treated as failed) rather than queue longer than this.
BOOK_SCANNER_METADATA_RATE_LIMIT_MAX_WAIT_SECONDS=60
BOOK_SCANNER_METRICS_ENABLED=true
BOOK_SCANNER_METRICS_BEARER_TOKEN=replace-with-a-long-random-monitoring-token

# Authentication mode:
#   local - LDAP turned off; accounts and passwords live in the local database.
#           Create them with: manage.py set_local_password <username> [--admin]
#   ldap  - authenticate against the LDAP directory configured below.
# (stub accepts any password and is for development/tests only; production rejects it.)
BOOK_SCANNER_LDAP_MODE=local

# LDAP settings below are ignored unless BOOK_SCANNER_LDAP_MODE=ldap.
# Either set a user DN template or configure service-bind search.
BOOK_SCANNER_LDAP_SERVER_URI=ldaps://ldap.example.org:636
BOOK_SCANNER_LDAP_USER_DN_TEMPLATE=uid={username},ou=people,dc=example,dc=org
BOOK_SCANNER_LDAP_USER_SEARCH_BASE=
BOOK_SCANNER_LDAP_USER_SEARCH_FILTER=(uid={username})
BOOK_SCANNER_LDAP_SERVICE_BIND_DN=
BOOK_SCANNER_LDAP_SERVICE_BIND_PASSWORD=
BOOK_SCANNER_LDAP_EMAIL_ATTRIBUTE=mail
# Attribute whose directory value becomes the local username (so "Alice" == "alice").
BOOK_SCANNER_LDAP_USERNAME_ATTRIBUTE=uid
# TLS (ldaps:// and StartTLS) validates the server certificate and hostname by default.
# Point at your CA bundle if the directory uses a private CA; empty = system trust store.
BOOK_SCANNER_LDAP_CA_FILE=
# Set to false ONLY for a lab LDAP with a self-signed certificate (disables validation).
BOOK_SCANNER_LDAP_TLS_REQUIRE_CERT=true
BOOK_SCANNER_LDAP_START_TLS=false

# Optional: URL of the separate audiobook server (e.g. Audiobookshelf). Audio uploads
# are rejected with a link to it; empty = a generic "ask the admins" message.
BOOK_SCANNER_AUDIOBOOK_SERVICE_URL=

# Remote OCR worker contract.
BOOK_SCANNER_OCR_SERVICE_URL=http://ocr-ai-server.example.org:8020
BOOK_SCANNER_OCR_REQUEST_TIMEOUT=30
# Polling is wall-clock based: ~25 min deadline, 2s interval backing off to 15s,
# upload timeout 300s, OCR RQ job timeout 2h. Defaults work for real OCR; the
# knobs below are optional and may be set here or in the process environment.
#   BOOK_SCANNER_OCR_POLL_DEADLINE_SECONDS=1500
#   BOOK_SCANNER_OCR_POLL_INTERVAL_START_SECONDS=2
#   BOOK_SCANNER_OCR_POLL_INTERVAL_MAX_SECONDS=15
#   BOOK_SCANNER_OCR_SUBMIT_TIMEOUT=300
#   BOOK_SCANNER_OCR_JOB_TIMEOUT_SECONDS=7200
#   BOOK_SCANNER_CONVERTER_TIMEOUT_SECONDS=1800
# Legacy attempt-based settings (only honoured when changed from 40 / 0.2):
# BOOK_SCANNER_OCR_MAX_ATTEMPTS=40
# BOOK_SCANNER_OCR_POLL_INTERVAL_SECONDS=0.2

# Production TLS settings (enable only behind a correctly configured HTTPS proxy).
BOOK_SCANNER_SECURE_SSL_REDIRECT=false
BOOK_SCANNER_SECURE_PROXY_SSL_HEADER=false
BOOK_SCANNER_SESSION_COOKIE_SECURE=false
BOOK_SCANNER_CSRF_COOKIE_SECURE=false
BOOK_SCANNER_SECURE_HSTS_SECONDS=0
BOOK_SCANNER_SECURE_HSTS_PRELOAD=false
BOOK_SCANNER_CSRF_TRUSTED_ORIGINS=[]

# ScanTailor workspace SSE cadence and connection lifetime.
BOOK_SCANNER_SCANTAILOR_EVENT_STREAM_INTERVAL_SECONDS=1.0
BOOK_SCANNER_SCANTAILOR_EVENT_STREAM_MAX_EVENTS=45

# Default capture layout for new scan jobs (#55). single_page: every image is one
# page (the project's scanner), so Page Split is a recorded passthrough. spread: an
# image may hold two facing pages and Page Split detects the gutter. Scanner ids
# listed in SCAN_SPREAD_SCANNER_IDS (JSON list) default to spread.
BOOK_SCANNER_SCAN_DEFAULT_CAPTURE_LAYOUT=single_page
BOOK_SCANNER_SCAN_SPREAD_SCANNER_IDS=[]
